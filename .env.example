# Upstash Redis Configuration (Rate Limiting)
UPSTASH_REDIS_REST_URL="https://your-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token_here"

# Resend API Configuration (Transactional Email Delivery)
RESEND_API_KEY="re_your_resend_api_key_here"
CONTACT_EMAIL_TO="advisory@yourdomain.com"
CONTACT_EMAIL_FROM="onboarding@resend.dev"

# Cloudflare Turnstile Configuration (Bot & Spam Protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAA_your_site_key_here"
TURNSTILE_SECRET_KEY="0x4AAAAAAA_your_secret_key_here"
